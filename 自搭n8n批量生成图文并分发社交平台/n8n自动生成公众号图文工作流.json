    {
      "parameters": {
        "language": "python",
        "pythonCode": "from datetime import datetime\nimport random\nimport re\n\nfor item in items:\n    data = item.get(\"json\", {})\n\n    # 这里直接从合并后的同一个 item 里取 title\n    title = (\n        data.get(\"title\")  # 如果你用 Set 把 output.title 映射成了 title\n        or data.get(\"output\", {}).get(\"title\")  # 否则直接读 output.title\n        or \"未命名\"\n    )\n\n    clean_title = re.sub(r\"[\\\\/:*?\\\"<>|$!:]|[^a-zA-Z0-9\\u4e00-\\u9fa5\\s-]\", \"_\", title).strip(\"_ \")\n    ts = datetime.now().strftime(\"%Y%m%d%H%M%S\")\n    rand6 = random.randint(100000, 999999)\n\n    file_name = f\"{clean_title}_{ts}_{rand6}.png\"\n    file_path = f\"/data/fengmian/{file_name}\"\n\n    data.update({\n        \"title\": title,\n        \"file_name\": file_name,\n        \"file_path\": file_path,\n    })\n\nreturn items\n"
      },
